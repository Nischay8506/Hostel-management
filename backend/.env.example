# Backend-only settings. Do not place secrets in VITE_* variables.
# Preserve existing .env files. Copy this example only for a new environment.
DATABASE_URL=postgresql+psycopg://hostel:replace-before-use@localhost:5432/hostel
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@cityhive.local
ADMIN_PASSWORD=replace-with-a-strong-owner-password
ADMIN_PHONE=
APP_ENVIRONMENT=development
AUTO_MIGRATE=true
RELEASE_ID=local
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# In production: APP_ENVIRONMENT=production, AUTO_MIGRATE=false, a persistent
# PostgreSQL URL, and explicit HTTPS frontend origins. Migrate after a backup.
JOBS_ENABLED=true
# For a separate worker or external scheduler set JOBS_ENABLED=false.
# An external scheduler POSTs /api/internal/jobs/run using X-Cityhive-Job-Token.
JOB_RUNNER_TOKEN=
UPCOMING_REMINDER_DAYS=3
PERCENTAGE_DISCOUNTS_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=billing@cityhive.local
# Production SMTP: verified sender and SMTP_SECURITY=starttls (587) or ssl (465).
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_AUTH_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_COUNTRY_CODE=91
WHATSAPP_REQUEST_TIMEOUT=8
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Optional SMS OTP fallback; use an approved Twilio sender.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Approved utility template with body parameters: enquiry ID, status.
WHATSAPP_ADMISSION_TEMPLATE_NAME=
AUTOMATIC_BILLING_ENABLED=true
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store privately and back it up separately; losing this key makes documents unreadable.
IDENTITY_DOCUMENT_KEY=
